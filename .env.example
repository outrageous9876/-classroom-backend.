# Get your connection string from the Neon Console:
# Project -> Dashboard -> Connect
DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require&channel_binding=require"

# Used by better-auth to sign sessions/tokens. Generate one with:
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32+-char-secret"
BETTER_AUTH_URL="http://localhost:5000"

# Must match the Vite dev server / deployed frontend origin (used for CORS + better-auth trusted origins)
FRONTEND_URL="http://localhost:5173"

PORT=5000
